# Campus to Career — Environment Variables
# ─────────────────────────────────────────────────────────────
# INSTRUCTIONS:
#   1. Copy this file: `Copy-Item .env.example .env`
#   2. Fill in real values in .env — NEVER commit .env to git
#   3. This .env.example file is safe to commit (no real secrets)
# ─────────────────────────────────────────────────────────────

# ────────────────────────────────────────────────────────────
# Backend (FastAPI)
# ────────────────────────────────────────────────────────────

# Secret key for JWT signing — change to a random 64-char string in production
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-64-char-string

# Database connection URL
# Development default: SQLite (no setup required)
# Production: switch to PostgreSQL — e.g. postgresql+asyncpg://user:pass@host/db
DATABASE_URL=sqlite:///./campus_to_career.db

# Ollama local inference server
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:2b

# File upload settings
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# Allowed CORS origins (comma-separated for multiple)
# Must match the URL where the frontend is served
CORS_ORIGINS=http://localhost:3000

# ────────────────────────────────────────────────────────────
# Frontend (Next.js)
# ────────────────────────────────────────────────────────────

# Public API base URL — must be reachable from the browser
# NEXT_PUBLIC_ prefix makes this available client-side
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
